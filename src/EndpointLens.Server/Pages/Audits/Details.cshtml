@page "{id:int}"
@model EndpointLens.Server.Pages.Audits.DetailsModel
@{
    var a = Model.Data.Audit;
    ViewData["Title"] = $"Audit of {a.Hostname}";
    var tab = Model.Tab == "findings" || ViewHelpers.EvidenceTabs.Any(t => t.Key == Model.Tab) ? Model.Tab : "findings";
    var all = Model.Data.Findings;
    (Outcome? Value, string Label)[] filters = { (null, "All"), (Outcome.Fail, "Fail"), (Outcome.Warning, "Warning"), (Outcome.Unknown, "Unknown"), (Outcome.Pass, "Pass") };
}

<div class="page-head">
    <div>
        <div class="crumb"><a asp-page="/Index">Overview</a> › <a asp-page="/Endpoints/Details" asp-route-id="@a.EndpointId">@a.Endpoint?.Name</a> › Audit #@a.Id</div>
        <h1>Audit of @a.Hostname</h1>
        <p>@a.OsCaption · collected @ViewHelpers.Utc(a.CollectedAtUtc) · @(a.Source == "import" ? "imported from file" : "uploaded by agent " + a.AgentVersion)</p>
    </div>
    <div class="actions">
        <a class="btn primary" asp-page="Report" asp-route-id="@a.Id">View report</a>
        <a class="btn" asp-page="Report" asp-route-id="@a.Id" asp-route-download="true">Download</a>
        <a class="btn" href="/audits/@a.Id/export/csv">Export CSV</a>
        <a class="btn" href="/audits/@a.Id/export/json">Export JSON</a>
    </div>
</div>

<partial name="_AuditHeader" model="a" />

<nav class="tabs">
    <a class="@(tab == "findings" ? "active" : "")" asp-route-tab="findings">Findings <span class="count">@all.Count</span></a>
    @foreach (var t in ViewHelpers.EvidenceTabs)
    {
        <a class="@(tab == t.Key ? "active" : "")" asp-route-tab="@t.Key">@t.Label</a>
    }
</nav>

@if (tab == "findings")
{
    <div class="filters">
        <div class="seg">
            @foreach (var f in filters)
            {
                var n = f.Value is null ? all.Count : all.Count(x => x.Outcome == f.Value);
                <a class="@(Model.Outcome == f.Value ? "active" : "")" asp-route-tab="findings" asp-route-outcome="@f.Value">@f.Label (@n)</a>
            }
        </div>
        <span class="muted small">Click a check to see the evidence and what to do.</span>
    </div>
    <div class="card flush"><partial name="_FindingsList" model="Model.Shown" /></div>
}
else if (Model.Data.Snapshot is not null)
{
    <partial name="_EvidenceTab" model="new EvidenceTabModel(Model.Data.Snapshot, tab)" />
}
