<Window x:Class="EndpointLens.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EndpointLens.Agent"
        Title="EndpointLens Agent" Width="1080" Height="740" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Top bar ===== -->
        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,14">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource Primary}">
                        <TextBlock Text="EL" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="EndpointLens" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock Text="Security audit agent" Style="{StaticResource MutedText}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="ComputerName" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Border x:Name="AdminPill" Style="{StaticResource Pill}" Margin="0,0,12,0">
                        <TextBlock x:Name="AdminPillText" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <Button x:Name="ServerButton" Click="OpenSettings_Click" Padding="12,7">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ServerDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ServerButtonText" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Stepper ===== -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="Step1Dot" Width="26" Height="26" CornerRadius="13"><TextBlock x:Name="Step1Num" Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/></Border>
                <TextBlock x:Name="Step1Text" Text="Ready" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>
            <Rectangle Width="60" Height="2" Fill="{StaticResource Line}" Margin="14,0" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal">
                <Border x:Name="Step2Dot" Width="26" Height="26" CornerRadius="13"><TextBlock x:Name="Step2Num" Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/></Border>
                <TextBlock x:Name="Step2Text" Text="Collecting" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>
            <Rectangle Width="60" Height="2" Fill="{StaticResource Line}" Margin="14,0" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal">
                <Border x:Name="Step3Dot" Width="26" Height="26" CornerRadius="13"><TextBlock x:Name="Step3Num" Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/></Border>
                <TextBlock x:Name="Step3Text" Text="Results" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>
        </StackPanel>

        <!-- ===== Step 1: Ready ===== -->
        <Grid x:Name="ReadyView" Grid.Row="2" Margin="24,18,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorder}" Padding="28">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Audit this computer" Style="{StaticResource H1}"/>
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedText}" FontSize="14"
                                   Text="EndpointLens reads this PC's hardware, software, accounts and security settings, then checks them against 11 security rules. Nothing on this PC is changed."/>

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="Computer" Style="{StaticResource MutedText}" Margin="0,0,0,10"/>
                            <TextBlock x:Name="InfoComputer" Grid.Column="1" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="1" Text="Windows" Style="{StaticResource MutedText}" Margin="0,0,0,10"/>
                            <TextBlock x:Name="InfoWindows" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="2" Text="Signed-in user" Style="{StaticResource MutedText}" Margin="0,0,0,10"/>
                            <TextBlock x:Name="InfoUser" Grid.Row="2" Grid.Column="1" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="3" Text="Last audit" Style="{StaticResource MutedText}"/>
                            <TextBlock x:Name="InfoLastAudit" Grid.Row="3" Grid.Column="1" FontWeight="SemiBold"/>
                        </Grid>

                        <Border x:Name="AdminBanner" Style="{StaticResource Banner}" Background="{StaticResource WarnSoft}" BorderBrush="#FEDF89" Margin="0,22,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Restart as administrator" Click="RestartElevated_Click" Padding="12,6" FontSize="13"/>
                                <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource Warn}" FontSize="13"
                                           Text="Not running as administrator. BitLocker and a few settings will show as Unknown."/>
                            </DockPanel>
                        </Border>
                        <Border x:Name="ServerBanner" Style="{StaticResource Banner}" Background="{StaticResource PrimarySoft}" BorderBrush="#C7D7FE">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Connect" Click="OpenSettings_Click" Padding="12,6" FontSize="13"/>
                                <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource PrimaryDark}" FontSize="13"
                                           Text="Not connected to the dashboard yet. You can still run the audit; it will be saved on this PC."/>
                            </DockPanel>
                        </Border>
                        <Border x:Name="PendingBanner" Style="{StaticResource Banner}" Background="{StaticResource NeutralSoft}" BorderBrush="{StaticResource Line}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Upload now" Click="UploadPending_Click" Padding="12,6" FontSize="13"/>
                                <TextBlock x:Name="PendingText" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="13"/>
                            </DockPanel>
                        </Border>

                        <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Click="Start_Click" HorizontalAlignment="Left"
                                Margin="0,26,0,0" Padding="28,13" FontSize="15">
                            <TextBlock Text="▶   Start audit" Foreground="White" FontWeight="SemiBold" FontSize="15"/>
                        </Button>
                        <TextBlock Text="Takes about 10 seconds." Style="{StaticResource MutedText}" Margin="2,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="What will be collected" Style="{StaticResource H2}" Margin="0,0,0,14"/>
                    <ItemsControl x:Name="PlanList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource NeutralSoft}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Icon}" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== Step 2: Collecting ===== -->
        <Border x:Name="CollectView" Grid.Row="2" Style="{StaticResource CardBorder}" Margin="24,18,24,24" MaxWidth="760" VerticalAlignment="Top" Visibility="Collapsed" Padding="28">
            <StackPanel>
                <TextBlock Text="Collecting information…" Style="{StaticResource H1}"/>
                <TextBlock Text="Please keep this window open. Only reading — nothing is changed." Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                <DockPanel Margin="0,20,0,6">
                    <TextBlock x:Name="CollectCount" DockPanel.Dock="Right" Style="{StaticResource MutedText}"/>
                    <TextBlock Text="Progress" Style="{StaticResource Label}"/>
                </DockPanel>
                <ProgressBar x:Name="CollectProgress" Height="8" Maximum="7" Foreground="{StaticResource Primary}" Background="{StaticResource NeutralSoft}" BorderThickness="0"/>
                <ItemsControl x:Name="CollectList" Margin="0,20,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,11">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="14" Background="{Binding IconBg}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}" Foreground="{Binding IconFg}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Duration}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ===== Step 3: Results ===== -->
        <Grid x:Name="ResultsView" Grid.Row="2" Margin="24,18,24,24" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Upload status bar -->
            <Border Grid.ColumnSpan="3" Style="{StaticResource CardBorder}" Padding="18,14" Margin="0,0,0,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="UploadButton" Style="{StaticResource PrimaryButton}" Content="Upload to dashboard" Click="Upload_Click" Margin="8,0,0,0"/>
                        <Button x:Name="OpenDashboardButton" Style="{StaticResource PrimaryButton}" Content="Open in dashboard" Click="OpenDashboard_Click" Margin="8,0,0,0"/>
                        <Button Content="Save a copy" Click="SaveCopy_Click" Margin="8,0,0,0"/>
                        <Button Content="View data" Click="ViewData_Click" Margin="8,0,0,0"/>
                        <Button Content="↻  Run again" Click="RunAgain_Click" Margin="8,0,0,0"/>
                    </StackPanel>
                    <Border x:Name="UploadIcon" Width="30" Height="30" CornerRadius="15" VerticalAlignment="Center">
                        <TextBlock x:Name="UploadIconText" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="UploadTitle" FontWeight="SemiBold"/>
                        <TextBlock x:Name="UploadDetail" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Score -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Security score" Style="{StaticResource Label}"/>
                            <Grid Width="140" Height="140" Margin="0,14,0,10" HorizontalAlignment="Center">
                                <local:ScoreRing x:Name="Ring"/>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="ScoreText" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="out of 100" Style="{StaticResource MutedText}" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <Border x:Name="RiskPill" Style="{StaticResource Pill}" HorizontalAlignment="Center" Padding="12,4">
                                <TextBlock x:Name="RiskText" FontWeight="SemiBold" FontSize="13"/>
                            </Border>
                            <TextBlock x:Name="CoverageText" Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,10,0,0"/>
                            <UniformGrid Columns="4" Margin="0,18,0,0">
                                <StackPanel><TextBlock x:Name="FailCount" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Bad}" HorizontalAlignment="Center"/><TextBlock Text="Fail" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel><TextBlock x:Name="WarnCount" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Warn}" HorizontalAlignment="Center"/><TextBlock Text="Warning" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel><TextBlock x:Name="UnknownCount" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Neutral}" HorizontalAlignment="Center"/><TextBlock Text="Unknown" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel><TextBlock x:Name="PassCount" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Good}" HorizontalAlignment="Center"/><TextBlock Text="Pass" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/></StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Findings -->
            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,18">
                        <DockPanel>
                            <CheckBox x:Name="ShowPassed" DockPanel.Dock="Right" Content="Show passed checks" VerticalAlignment="Center" Checked="ShowPassed_Changed" Unchecked="ShowPassed_Changed"/>
                            <StackPanel>
                                <TextBlock x:Name="FindingsTitle" Style="{StaticResource H2}"/>
                                <TextBlock Text="Each check shows what was found and what to do about it." Style="{StaticResource MutedText}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="AllGood" Margin="24" Visibility="Collapsed" Foreground="{StaticResource Good}" FontWeight="SemiBold"
                                       Text="✓  Nothing needs attention. Tick “Show passed checks” to see every result."/>
                            <ItemsControl x:Name="FindingsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,16">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource Pill}" Background="{Binding OutcomeBg}" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding OutcomeText}" Foreground="{Binding OutcomeFg}" FontWeight="Bold" FontSize="11"/>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding Observed}" Margin="0,6,0,0" FontSize="13"/>
                                                    <Border Visibility="{Binding AdviceVisibility}" Background="{StaticResource Bg}" CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                                                        <TextBlock FontSize="13">
                                                            <Run Text="What to do: " FontWeight="SemiBold"/><Run Text="{Binding Advice, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== Server settings (overlay) ===== -->
        <Grid x:Name="SettingsOverlay" Grid.RowSpan="3" Background="#80101828" Visibility="Collapsed">
            <Border Style="{StaticResource CardBorder}" Width="540" VerticalAlignment="Center" Padding="28">
                <StackPanel>
                    <TextBlock Text="Connect to the dashboard" Style="{StaticResource H1}" FontSize="20"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0" FontSize="13">
                        1. On the dashboard, click <Bold>Enroll endpoint</Bold> and give this PC a name.<LineBreak/>
                        2. Copy the credential it shows (it starts with el_).<LineBreak/>
                        3. Paste it below and click <Bold>Test connection</Bold>.
                    </TextBlock>
                    <TextBlock Text="Server address" Style="{StaticResource Label}" Margin="0,18,0,6"/>
                    <TextBox x:Name="ServerUrlBox"/>
                    <TextBlock Text="Endpoint credential" Style="{StaticResource Label}" Margin="0,14,0,6"/>
                    <PasswordBox x:Name="TokenBox"/>
                    <TextBlock x:Name="SettingsStatus" Margin="0,12,0,0" FontSize="13" Visibility="Collapsed"/>
                    <DockPanel Margin="0,22,0,0" LastChildFill="False">
                        <Button DockPanel.Dock="Left" Content="Test connection" Click="TestConnection_Click"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Save" Click="SaveSettings_Click" Margin="10,0,0,0" MinWidth="90"/>
                        <Button DockPanel.Dock="Right" Content="Cancel" Click="CloseSettings_Click"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,16,0,0"
                               Text="The credential is stored encrypted for your Windows account and only allows this PC to upload audits."/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
